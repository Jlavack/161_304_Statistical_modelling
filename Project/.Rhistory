mu <- a + WMaxYB*TempMaxWinYearBefore + WMinYB*TempMaxWinYearBefore,
a ~ dnorm(0, 0.2),
c(WMinYB, WMaxYB) ~ dnorm(0, 0.2),
sigma ~ dexp(1)
), data = brazil_std
)
mSummer <- quap(
alist(
PI ~ dnorm(mu, sigma),
mu <- a + SMinYB*TempMinWinYearBefore + SMinYB*TempMaxWinYearBefore,
a ~ dnorm(0, 0.2),
c(SMinYB, SMaxYB) ~ dnorm(0, 0.2),
sigma ~ dexp(1)
), data = brazil_std
)
coeftab_plot( coeftab(mSummer, mWinter))
